<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the update check: one anonymous GET of the GitHub releases page for this app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App lock: fingerprint or the phone's PIN through the system prompt -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Spend alerts after a background sync. Asked for once bank sync is set up, never at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- To open release links in a real browser (Browsers.kt), the browsers have to be visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DdfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DeadDropFinance">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A receipt shared from another app (a photo, a screenshot, a PDF): it opens the receipt scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- The camera app writes the receipt photo here (the app's cache, deleted right after reading). No camera permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>
        <!-- A spend alert's Approve button. Only this app's own notifications can reach it. -->
        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />
    </application>

</manifest>
