<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the update check and its download (one anonymous GET of this app's GitHub releases). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Server sync (1.6.0): Android 17 blocks an app from addresses on the phone's own Wi-Fi network (a home server)
         without this (Nearby devices). Asked for only when Connect or a QR pairing is tapped. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- App lock: fingerprint or the phone's PIN through the system prompt -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Bill reminders and autopay warnings. Asked for when one is turned on, never at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Download and install (0.15.1): installing the verified release APK through PackageInstaller. Android asks
         the user to turn this on the first time; the app never installs anything unverified. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Scan QR code (1.5.0): the desktop program's Add a phone code, read on the phone. Asked for only when Scan QR code
         is tapped; refused, the server's address is typed instead. (The scanner library declares it too.) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Read-only: whether the network is metered, to warn before an update downloads over mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- To open release links in a real browser (Browsers.kt), the browsers have to be visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Plain HTTP is for server sync (1.4.0) only: the app talks to the user's own Dead Drop server on their network,
         and every request and reply is a libsodium envelope, so only ciphertext crosses it. The update check and its
         download stay on HTTPS, enforced by res/xml/network_security_config.xml (1.6.0). -->
    <application
        android:name=".DdfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DeadDropFinance">
        <!-- Rotation, keyboard and theme changes are handled by Compose in place: the screen and anything being
             typed or picked are kept (the activity isn't rebuilt). -->
        <!-- The PackageInstaller's answer to Download and install: opens Android's install confirmation. Not exported. -->
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A receipt shared from another app (a photo, a screenshot, a PDF): it opens the receipt scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- The camera app writes the receipt photo here (the app's cache, deleted right after reading). No camera permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>
        <!-- The QR scanner (ZXing Android Embedded): follows the phone's rotation, as the rest of the app does. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />
    </application>

</manifest>
