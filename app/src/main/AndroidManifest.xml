<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bank sync with SimpleFIN (only when set up) and the update check (one anonymous GET of this app's GitHub releases). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App lock: fingerprint or the phone's PIN through the system prompt -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Spend alerts after a background sync. Asked for once bank sync is set up, never at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Download and install (0.15.1): installing the verified release APK through PackageInstaller. Android asks
         the user to turn this on the first time; the app never installs anything unverified. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Read-only: whether the network is metered, to warn before an update downloads over mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- To open release links in a real browser (Browsers.kt), the browsers have to be visible. -->
    <queries>
        <!-- The app picker for reading bank notifications lists the phone's apps that have a launcher icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DdfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DeadDropFinance">
        <!-- Rotation, keyboard and theme changes are handled by Compose in place: the screen and anything being
             typed or picked are kept (the activity isn't rebuilt). -->
        <!-- The PackageInstaller's answer to Download and install: opens Android's install confirmation. Not exported. -->
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A receipt shared from another app (a photo, a screenshot, a PDF): it opens the receipt scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- The camera app writes the receipt photo here (the app's cache, deleted right after reading). No camera permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>
        <!-- Reading the notifications of the bank and wallet apps the user picks. Off (disabled) until the user turns it
             on in More, Alerts; only Android can bind it, and only once the user grants notification access. -->
        <service
            android:name=".alerts.BankNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="Dead Drop Finance: bank notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- A spend alert's Approve button. Only this app's own notifications can reach it. -->
        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />
    </application>

</manifest>
